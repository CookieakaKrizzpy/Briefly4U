# Kopieren nach ".env" und anpassen. .env wird nie eingecheckt (siehe .gitignore).

# --- Provider ---
# "ollama" (Standard) = lokales Vision-LLM, keine Kosten, Daten verlassen den Rechner nie.
# "anthropic" = Cloud-API (Pay-as-you-go), höhere Erkennungsqualität, benötigt API-Key unten.
BRIEFLY_PROVIDER=ollama

# --- Ollama (lokal) ---
# Modell muss vorher installiert sein: ollama pull qwen2.5vl:7b
# Empfehlung für 8GB VRAM (z.B. RTX 3070 Ti): qwen2.5vl:7b (stark bei Dokumenten/OCR)
# Alternative mit mehr Qualitätsanspruch (braucht ggf. RAM-Offload): llama3.2-vision:11b
BRIEFLY_OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_HOST=http://localhost:11434
# Kontextfenster - bei Fehler "exceed_context_size_error" hier weiter erhöhen
BRIEFLY_OLLAMA_NUM_CTX=8192

# Server/Modell werden automatisch gestartet bzw. heruntergeladen, falls nötig
# (siehe ollama_bootstrap.py) - normalerweise ist nichts weiter einzurichten.
# Nur für Entwicklung/Sonderfälle:
# BRIEFLY_OLLAMA_BIN=C:\pfad\zu\ollama.exe
# BRIEFLY_OLLAMA_MODELS_DIR=C:\pfad\zu\modellordner

# --- Anthropic (Cloud, nur falls BRIEFLY_PROVIDER=anthropic) ---
# API-Key von https://console.anthropic.com (separat vom Claude-Code-Abo)
# ANTHROPIC_API_KEY=sk-ant-...
# BRIEFLY_MODEL=claude-haiku-4-5

# --- Bildvorverarbeitung ---
# Perspektivkorrektur/Belichtungsausgleich für Fotos deaktivieren (Standard: true)
# BRIEFLY_PREPROCESS=false
# Zwischenschritte der Konturerkennung (Kanten, gewählte Kontur) als Bilder
# unter logs/image_debug/ speichern - hilfreich, um zu sehen, warum bei
# einem bestimmten Foto keine Perspektivkorrektur angewendet wurde.
# BRIEFLY_DEBUG_IMAGE_PREP=true

# --- Updates ---
# Nur nötig, weil das Release-Repo privat ist - GitHub Personal Access Token
# (Fine-grained, nur Lesezugriff auf das Briefly-Repo) für den Update-Check
# unter Einstellungen -> Updates. Ohne Token wird der Check übersprungen.
# BRIEFLY_GITHUB_TOKEN=github_pat_...
